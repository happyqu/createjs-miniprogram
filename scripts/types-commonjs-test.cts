import c = require('@happyqu/createjs-miniprogram/lite');
import '@happyqu/createjs-miniprogram/lite/animation';
import '@happyqu/createjs-miniprogram/lite/filters';
import full = require('@happyqu/createjs-miniprogram');
import type {CreateJS} from '@happyqu/createjs-miniprogram';
import type {CreateJSLite} from '@happyqu/createjs-miniprogram/lite';
import '@happyqu/createjs-miniprogram/tweenjs';
const s = new c.Stage(c.createCanvas(100,100));
const b = new c.Bitmap({width:10,height:10});
b.setBounds(0,0,10,10); b.invalidate();
c.Tween.get(b).to({x:1},100,c.Ease.quadOut);
c.Ticker.addEventListener('tick', event => s.update(event));
full.Tween.get(b).to({x:2},100,full.Ease.quadOut);
new c.MovieClip({paused:true});
new c.BlurFilter(2,2,1);
const enabled: boolean = c.performance.enable;
const count: number = c.performance.getMetrics().drawCalls;
const typedFull: CreateJS = full;
const typedLite: CreateJSLite = c;
s.handleEvent({type:'tick'});
c.Ticker.on('tick', event => s.update({delta:event.delta}));
s.dispose(); void [enabled,count,typedFull,typedLite];
